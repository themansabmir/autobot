{
  "extends": "@typebot.io/tsconfig/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@typebot.io/i18n": [
        "../../packages/i18n/src/index.ts"
      ],
      "@typebot.io/i18n/*": [
        "../../packages/i18n/src/*.ts"
      ],
      "@typebot.io/bot-engine/*": [
        "../../packages/bot-engine/src/*.ts"
      ],
      "@typebot.io/bot-engine": [
        "../../packages/bot-engine/src/index.ts"
      ]
    },
    "strictNullChecks": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}